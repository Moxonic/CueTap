{
  "name": "cuetap",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Phone-based sound cue playback for small theaters and rehearsals.",
  "scripts": {
    "dev": "vite",
    "dev:phone": "node scripts/dev-phone.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "icons": "node scripts/gen-icons.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-basic-ssl": "^1.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^0.21.1"
  }
}
